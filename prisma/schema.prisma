generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            String      @id @default(cuid())
  fullName      String
  phone         String
  email         String?
  address       String
  city          String
  paymentMethod String      @default("COD")
  totalAmount   Float
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  name      String
  price     Float
  quantity  Int
  size      String1
}